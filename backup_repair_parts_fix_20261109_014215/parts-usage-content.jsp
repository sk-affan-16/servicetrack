<div class="heading"><div><h1>Spare Parts Usage</h1><p class="subtitle">Record the parts consumed for your assigned repair jobs.</p></div></div>
<%if(error!=null){%><div class="alert alert-error"><%=esc(error)%></div><%}%><%if(success!=null){%><div class="alert alert-success"><%=esc(success)%></div><%}%>
<div class="card"><h2>Record Spare Part Usage</h2><form method="post" action="<%=request.getContextPath()%>/technician/parts-usage"><div class="form-group"><label for="ticketId">Assigned Ticket</label><select id="ticketId" name="ticketId" required><option value="">-- Select ticket --</option><%for(Ticket t:assignedTickets){%><option value="<%=t.getTicketId()%>" <%=selectedTicketId!=null&&selectedTicketId.equals(t.getTicketId())?"selected":""%>><%=esc(t.getTicketNumber())%> · #<%=t.getTicketId()%></option><%}%></select><%if(assignedTickets.isEmpty()){%><p class="muted">No tickets are currently assigned to you.</p><%}%></div>
<div class="form-group"><label for="sparePartId">Spare Part</label><select id="sparePartId" name="sparePartId" required><option value="">-- Select spare part --</option><%for(SparePart p:availableParts){%><option value="<%=p.getSparePartId()%>"><%=esc(p.getPartName())%> · <%=esc(p.getPartNumber())%> (Stock: <%=p.getQuantity()%>)</option><%}%></select><%if(availableParts.isEmpty()){%><p class="muted">No spare parts are currently available.</p><%}%></div><div class="form-group"><label for="quantity">Quantity Used</label><input type="number" id="quantity" name="quantity" min="1" required placeholder="Enter quantity"></div><button class="btn" type="submit" <%=assignedTickets.isEmpty()||availableParts.isEmpty()?"disabled":""%>>Record Parts Usage</button></form></div><a class="btn secondary" href="<%=request.getContextPath()%>/technician/">← Back to Dashboard</a>