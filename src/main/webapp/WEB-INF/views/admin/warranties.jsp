<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Warranty Management</title><style>body{font-family:Arial;margin:28px;background:#f4f6f9} .box{background:white;padding:20px;margin-bottom:20px;border-radius:8px}table{border-collapse:collapse;width:100%;background:white}th,td{border:1px solid #ddd;padding:9px;text-align:left}input,select,button{padding:8px;margin:5px}button{cursor:pointer}</style></head><body class="warranty-page">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/warranty.css">
<h1>Warranty Management</h1><p><a href="${pageContext.request.contextPath}/admin/dashboard">Admin Dashboard</a></p>
<c:if test="${param.success == '1'}"><p style="color:green">Warranty saved successfully.</p></c:if><c:if test="${not empty error}"><p style="color:red"><c:out value="${error}"/></p></c:if>
<div class="box"><h2>Assign / Update Warranty</h2><p>Select a registered product. Saving an existing product updates its warranty dates.</p>
<form method="post" action="${pageContext.request.contextPath}/admin/warranties">
<label>Registered Product <select name="productId" required><option value="">-- Select Product --</option><c:forEach var="w" items="${warranties}"><option value="${w.productId}"><c:out value="${w.productName}"/> - <c:out value="${w.serialNumber}"/> (Customer: <c:out value="${w.customerName}"/>)</option></c:forEach></select></label>
<label>Warranty Start <input type="date" name="warrantyStart" required></label>
<label>Warranty End <input type="date" name="warrantyEnd" required></label><button type="submit">Save Warranty</button></form></div>
<div class="box"><h2>Registered Products & Warranty Status</h2><table><tr><th>Product</th><th>Brand / Model</th><th>Serial</th><th>Customer</th><th>Start</th><th>End</th><th>Effective Status</th><th>Admin Action</th></tr>
<c:forEach var="w" items="${warranties}"><tr><td><c:out value="${w.productName}"/> (ID: ${w.productId})</td><td><c:out value="${w.brand}"/> / <c:out value="${w.modelNumber}"/></td><td><c:out value="${w.serialNumber}"/></td><td><c:out value="${w.customerName}"/></td><td>${w.warrantyStart}</td><td>${w.warrantyEnd}</td><td><strong>${w.effectiveStatus}</strong></td><td><c:if test="${not empty w.warrantyId}"><form method="post" action="${pageContext.request.contextPath}/admin/warranties"><input type="hidden" name="action" value="status"><input type="hidden" name="warrantyId" value="${w.warrantyId}"><select name="status"><option value="ACTIVE">ACTIVE</option><option value="VOID">VOID</option></select><button type="submit">Update</button></form></c:if><c:if test="${empty w.warrantyId}">Not assigned</c:if></td></tr></c:forEach></table></div></body></html>
