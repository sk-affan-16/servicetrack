<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ page import="com.servicetrack.model.Ticket" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ticket Details | ServiceTrack</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/technician.css"></head><body>
<header class="topbar"><div class="brand">Service<span>Track</span></div><div class="topbar-right">Ticket Details</div></header><div class="shell"><aside class="sidebar"><div class="nav-label">Workspace</div><a class="nav-link" href="<%=request.getContextPath()%>/technician/">Dashboard</a><a class="nav-link active" href="<%=request.getContextPath()%>/technician/tickets">My Assigned Jobs</a><a class="nav-link" href="<%=request.getContextPath()%>/technician/parts-usage">Spare Parts Usage</a><a class="nav-link" href="<%=request.getContextPath()%>/logout">Logout</a></aside><main class="main">
<%String error=(String)request.getAttribute("error");Ticket ticket=(Ticket)request.getAttribute("ticket");if(error!=null){%><div class="alert alert-error"><%=error%></div><%}else if(ticket!=null){%>
<div class="heading"><div><h1>Ticket Details</h1><p class="subtitle">Review ticket information, then continue directly to its repair workspace.</p></div><div class="actions"><a class="btn" href="<%=request.getContextPath()%>/technician/repair?ticketId=<%=ticket.getTicketId()%>">Open Repair Workspace →</a></div></div>
<div class="card"><div class="grid"><div><div class="stat-title">Ticket ID</div><div class="stat-value">#<%=ticket.getTicketId()%></div></div><div><div class="stat-title">Ticket Number</div><div class="stat-value" style="font-size:17px"><%=ticket.getTicketNumber()%></div></div><div><div class="stat-title">Service Request ID</div><div class="stat-value">#<%=ticket.getServiceRequestId()%></div></div><div><div class="stat-title">Technician ID</div><div class="stat-value"><%=ticket.getTechnicianId()%></div></div></div><hr style="border:0;border-top:1px solid #e2e8f0;margin:22px 0"><div class="grid"><div><div class="stat-title">Current Status</div><span class="badge <%=ticket.getStatus().name().equals("COMPLETED")?"completed":"assigned"%>"><%=ticket.getStatus().name().replace('_',' ')%></span></div><div><div class="stat-title">Created At</div><strong><%=ticket.getCreatedAt()==null?"—":ticket.getCreatedAt().toString().replace('T',' ')%></strong></div><div><div class="stat-title">Last Updated</div><strong><%=ticket.getUpdatedAt()==null?"—":ticket.getUpdatedAt().toString().replace('T',' ')%></strong></div></div></div>
<div class="card"><h2>Next action</h2><p class="subtitle">Repair progress must be updated from the Repair Workspace. Ticket completion is synchronized from the repair record, so do not change it separately here.</p><a class="btn" href="<%=request.getContextPath()%>/technician/repair?ticketId=<%=ticket.getTicketId()%>">Go to Repair Workspace</a></div>
<%}else{%><div class="card">Ticket details are not available.</div><%}%><a class="btn secondary" href="<%=request.getContextPath()%>/technician/tickets">← Back to Assigned Jobs</a></main></div></body></html>