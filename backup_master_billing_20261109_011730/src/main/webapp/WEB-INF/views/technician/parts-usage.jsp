<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ page import="java.util.List" %><%@ page import="com.servicetrack.model.Ticket" %><%@ page import="com.servicetrack.model.SparePart" %>
<%! private String esc(String v){if(v==null)return "";return v.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} %>
<%List<Ticket> assignedTickets=(List<Ticket>)request.getAttribute("assignedTickets");List<SparePart> availableParts=(List<SparePart>)request.getAttribute("availableParts");Long selectedTicketId=(Long)request.getAttribute("selectedTicketId");String error=(String)request.getAttribute("error");String success=(String)session.getAttribute("success");if(success!=null)session.removeAttribute("success");if(assignedTickets==null)assignedTickets=java.util.Collections.emptyList();if(availableParts==null)availableParts=java.util.Collections.emptyList();%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Spare Parts Usage | ServiceTrack</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/technician.css"></head><body>
<header class="topbar"><div class="brand">Service<span>Track</span></div><div class="topbar-right">Spare Parts Usage</div></header><div class="shell"><aside class="sidebar"><div class="nav-label">Workspace</div><a class="nav-link" href="<%=request.getContextPath()%>/technician/">Dashboard</a><a class="nav-link" href="<%=request.getContextPath()%>/technician/tickets">My Assigned Jobs</a><a class="nav-link active" href="<%=request.getContextPath()%>/technician/parts-usage">Spare Parts Usage</a><a class="nav-link" href="<%=request.getContextPath()%>/logout">Logout</a></aside><main class="main"><div class="heading"><div><h1>Spare Parts Usage</h1><p class="subtitle">Record the parts consumed for your assigned repair jobs.</p></div></div>
<%if(error!=null){%><div class="alert alert-error"><%=esc(error)%></div><%}%><%if(success!=null){%><div class="alert alert-success"><%=esc(success)%></div><%}%>
<div class="card"><h2>Record Spare Part Usage</h2><form method="post" action="<%=request.getContextPath()%>/technician/parts-usage"><div class="form-group"><label for="ticketId">Assigned Ticket</label><select id="ticketId" name="ticketId" required><option value="">-- Select ticket --</option><%for(Ticket t:assignedTickets){%><option value="<%=t.getTicketId()%>" <%=selectedTicketId!=null&&selectedTicketId.equals(t.getTicketId())?"selected":""%>><%=esc(t.getTicketNumber())%> · #<%=t.getTicketId()%></option><%}%></select><%if(assignedTickets.isEmpty()){%><p class="muted">No tickets are currently assigned to you.</p><%}%></div>
<div class="form-group"><label for="sparePartId">Spare Part</label><select id="sparePartId" name="sparePartId" required><option value="">-- Select spare part --</option><%for(SparePart p:availableParts){%><option value="<%=p.getSparePartId()%>"><%=esc(p.getPartName())%> · <%=esc(p.getPartNumber())%> (Stock: <%=p.getQuantity()%>)</option><%}%></select><%if(availableParts.isEmpty()){%><p class="muted">No spare parts are currently available.</p><%}%></div><div class="form-group"><label for="quantity">Quantity Used</label><input type="number" id="quantity" name="quantity" min="1" required placeholder="Enter quantity"></div><button class="btn" type="submit" <%=assignedTickets.isEmpty()||availableParts.isEmpty()?"disabled":""%>>Record Parts Usage</button></form></div><a class="btn secondary" href="<%=request.getContextPath()%>/technician/">← Back to Dashboard</a></main></div></body></html>