<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ page import="java.util.List" %><%@ page import="com.servicetrack.model.Ticket" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Assigned Jobs | ServiceTrack</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/technician.css"></head><body>
<header class="topbar"><div class="brand">Service<span>Track</span></div><div class="topbar-right">My Assigned Jobs</div></header><div class="shell"><aside class="sidebar"><div class="nav-label">Workspace</div><a class="nav-link" href="<%=request.getContextPath()%>/technician/">Dashboard</a><a class="nav-link active" href="<%=request.getContextPath()%>/technician/tickets">My Assigned Jobs</a><a class="nav-link" href="<%=request.getContextPath()%>/technician/parts-usage">Spare Parts Usage</a><a class="nav-link" href="<%=request.getContextPath()%>/logout">Logout</a></aside>
<main class="main"><div class="heading"><div><h1>My Assigned Jobs</h1><p class="subtitle">Review your tickets and open the repair workspace to update progress.</p></div></div>
<% String error=(String)request.getAttribute("error"); if(error!=null){%><div class="alert alert-error"><%=error%></div><%}%>
<% List<Ticket> tickets=(List<Ticket>)request.getAttribute("tickets"); if(tickets==null||tickets.isEmpty()){%><div class="card empty"><h2>No assigned tickets</h2><p>New jobs assigned to you will appear here.</p></div><%}else{%>
<div class="table-wrap"><table><thead><tr><th>Ticket</th><th>Service Request</th><th>Status</th><th>Created</th><th>Actions</th></tr></thead><tbody>
<%for(Ticket ticket:tickets){String status=ticket.getStatus().name();%><tr><td><strong><%=ticket.getTicketNumber()%></strong><div class="muted">Ticket #<%=ticket.getTicketId()%></div></td><td>#<%=ticket.getServiceRequestId()%></td><td><span class="badge <%=status.equals("COMPLETED")?"completed":status.equals("ASSIGNED")?"assigned":status.equals("WAITING_FOR_PART")?"waiting":"repair"%>"><%=status.replace('_',' ')%></span></td><td><%=ticket.getCreatedAt()==null?"—":ticket.getCreatedAt().toString().replace('T',' ')%></td><td><div class="actions"><a class="btn secondary" href="<%=request.getContextPath()%>/technician/ticket?ticketId=<%=ticket.getTicketId()%>">Details</a><a class="btn" href="<%=request.getContextPath()%>/technician/repair?ticketId=<%=ticket.getTicketId()%>">Open Repair</a></div></td></tr><%}%>
</tbody></table></div><%}%><p style="margin-top:20px"><a class="btn secondary" href="<%=request.getContextPath()%>/technician/">Back to Dashboard</a></p></main></div></body></html>